@page "/orders"
@inject ContingentApi Api

<PageTitle>Приказы</PageTitle>

<h1>Приказы</h1>
<p class="subtitle">Приказ — основание для событий движения. События проводятся на странице студента.</p>

@if (error != null)
{
    <div class="alert alert-error">@error</div>
}

<div class="grid-2">
    <div>
        @if (orders == null)
        {
            <p class="muted">Загрузка…</p>
        }
        else if (orders.Count == 0)
        {
            <div class="card muted">Приказов пока нет.</div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>№</th>
                            <th>Дата</th>
                            <th>Тип</th>
                            <th>Подписал</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td>@order.Number</td>
                                <td>@order.Date.ToString("dd.MM.yyyy")</td>
                                <td>@order.OrderType</td>
                                <td>@order.SignedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card form">
        <h2>Регистрация приказа</h2>
        <div class="form-row">
            <label>Номер<input @bind="newOrder.Number" placeholder="15-ст" /></label>
            <label>Дата<input type="date" @bind="newOrder.Date" /></label>
        </div>
        <label>
            Тип приказа
            <input @bind="newOrder.OrderType" list="order-types" />
            <datalist id="order-types">
                <option value="О зачислении"></option>
                <option value="О переводе"></option>
                <option value="О предоставлении академического отпуска"></option>
                <option value="Об отчислении"></option>
                <option value="О восстановлении"></option>
                <option value="О выпуске"></option>
            </datalist>
        </label>
        <label>Подписал<input @bind="newOrder.SignedBy" placeholder="Ректор" /></label>
        <div><button class="primary" @onclick="CreateAsync">Зарегистрировать</button></div>
    </div>
</div>

@code {
    private List<Order>? orders;
    private Order newOrder = NewOrder();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            orders = await Api.GetOrdersAsync();
        }
        catch (Exception ex)
        {
            error = Labels.Error(ex);
            orders ??= new List<Order>();
        }
    }

    private async Task CreateAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(newOrder.Number) || string.IsNullOrWhiteSpace(newOrder.OrderType))
        {
            error = "Укажите номер и тип приказа.";
            return;
        }
        try
        {
            await Api.CreateOrderAsync(newOrder);
            newOrder = NewOrder();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = Labels.Error(ex);
        }
    }

    private static Order NewOrder()
    {
        return new Order { Date = DateTime.Today };
    }
}
