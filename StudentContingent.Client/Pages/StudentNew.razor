@page "/students/new"
@inject ContingentApi Api
@inject NavigationManager Navigation

<PageTitle>Новая карточка</PageTitle>

<a href="students">← К списку студентов</a>
<h1 style="margin-top:12px">Новая карточка студента</h1>
<p class="subtitle">Карточка создаётся со статусом «не зачислен». Группа назначается приказом о зачислении на странице студента.</p>

@if (error != null)
{
    <div class="alert alert-error">@error</div>
}

<div class="card form">
    <h2>Личные данные</h2>
    <div class="form-row">
        <label>Фамилия *<input @bind="student.LastName" /></label>
        <label>Имя *<input @bind="student.FirstName" /></label>
        <label>Отчество<input @bind="student.MiddleName" /></label>
    </div>
    <div class="form-row">
        <label>Дата рождения<input type="date" @bind="student.BirthDate" /></label>
        <label>
            Пол
            <select @bind="student.Gender">
                <option value="М">Мужской</option>
                <option value="Ж">Женский</option>
            </select>
        </label>
        <label>Гражданство<input @bind="student.Citizenship" /></label>
    </div>
    <div class="form-row">
        <label>№ зачётной книжки *<input @bind="student.RecordBookNumber" /></label>
        <label>
            Основа обучения
            <select @bind="student.FundingBasis">
                @foreach (var basis in Enum.GetValues<FundingBasis>())
                {
                    <option value="@basis">@Labels.Of(basis)</option>
                }
            </select>
        </label>
    </div>

    <h2 style="margin-top:12px">Контакты</h2>
    <div class="form-row">
        <label>Телефон<input @bind="phone" /></label>
        <label>E-mail<input type="email" @bind="email" /></label>
        <label>Адрес проживания<input @bind="address" /></label>
    </div>

    <div class="toolbar">
        <button class="primary" @onclick="SaveAsync" disabled="@saving">Создать карточку</button>
        <a class="button" href="students">Отмена</a>
    </div>
</div>

@code {
    private Student student = new()
    {
        BirthDate = new DateTime(2008, 1, 1),
        Gender = "М",
        Citizenship = "РФ"
    };
    private string phone = string.Empty;
    private string email = string.Empty;
    private string address = string.Empty;
    private string? error;
    private bool saving;

    private async Task SaveAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(student.LastName)
            || string.IsNullOrWhiteSpace(student.FirstName)
            || string.IsNullOrWhiteSpace(student.RecordBookNumber))
        {
            error = "Заполните фамилию, имя и номер зачётной книжки.";
            return;
        }

        student.Contacts.Clear();
        if (!string.IsNullOrWhiteSpace(phone))
        {
            student.AddContact(new ContactInfo { Type = ContactType.Phone, Value = phone.Trim(), IsPrimary = true });
        }
        if (!string.IsNullOrWhiteSpace(email))
        {
            student.AddContact(new ContactInfo { Type = ContactType.Email, Value = email.Trim() });
        }
        if (!string.IsNullOrWhiteSpace(address))
        {
            student.AddContact(new ContactInfo { Type = ContactType.Address, Value = address.Trim() });
        }

        saving = true;
        try
        {
            var created = await Api.CreateStudentAsync(student);
            Navigation.NavigateTo($"students/{created.Id}");
        }
        catch (Exception ex)
        {
            error = Labels.Error(ex);
        }
        finally
        {
            saving = false;
        }
    }
}
