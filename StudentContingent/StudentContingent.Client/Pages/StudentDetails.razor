@page "/students/{Id:guid}"
@inject ContingentApi Api
@inject NavigationManager Navigation

<PageTitle>@(student?.FullName ?? "Студент")</PageTitle>

<a href="students">← К списку студентов</a>

@if (loadError != null)
{
    <div class="alert alert-error" style="margin-top:12px">@loadError</div>
}
else if (student == null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <div class="toolbar" style="margin-top:12px">
        <h1>@student.FullName</h1>
        <span class="@Labels.Css(student.Status)">@Labels.Of(student.Status)</span>
    </div>
    <p class="subtitle">
        № зачётной книжки @student.RecordBookNumber ·
        @(student.StudyGroup is null ? "без группы" : "группа " + student.StudyGroup.Number)
    </p>

    @if (message != null)
    {
        <div class="alert alert-ok">@message</div>
    }
    @if (error != null)
    {
        <div class="alert alert-error">@error</div>
    }

    <div class="grid-2">
        <div class="card">
            <h2>Сведения</h2>
            <dl class="props">
                <dt>Дата рождения</dt>
                <dd>@student.BirthDate.ToString("dd.MM.yyyy")</dd>
                <dt>Пол</dt>
                <dd>@student.Gender</dd>
                <dt>Гражданство</dt>
                <dd>@student.Citizenship</dd>
                <dt>Основа обучения</dt>
                <dd>@Labels.Of(student.FundingBasis)</dd>
                <dt>Группа</dt>
                <dd>
                    @if (student.StudyGroup is null)
                    {
                        <span class="muted">—</span>
                    }
                    else
                    {
                        <a href="groups/@student.StudyGroupId">@student.StudyGroup.Number</a>
                    }
                </dd>
                <dt>Льготы</dt>
                <dd>@(student.Benefits.Count == 0 ? "—" : string.Join(", ", student.Benefits.Select(b => b.Name)))</dd>
            </dl>
        </div>

        <div class="card">
            <h2>Провести событие по приказу</h2>
            @if (allowed.Count == 0)
            {
                <p class="muted">Для статуса «@Labels.Of(student.Status)» допустимых событий нет.</p>
            }
            else if (orders.Count == 0)
            {
                <p class="muted">Сначала зарегистрируйте <a href="orders">приказ</a>.</p>
            }
            else
            {
                <div class="form">
                    <label>
                        Событие
                        <select @bind="movementType">
                            @foreach (var type in allowed)
                            {
                                <option value="@type">@Labels.Of(type)</option>
                            }
                        </select>
                    </label>
                    <label>
                        Приказ-основание
                        <select @bind="orderId">
                            <option value="">— выберите —</option>
                            @foreach (var order in orders)
                            {
                                <option value="@order.Id">№ @order.Number от @order.Date.ToString("dd.MM.yyyy")</option>
                            }
                        </select>
                    </label>
                    <label>Дата вступления в силу<input type="date" @bind="effectiveDate" /></label>
                    @if (Student.RequiresTargetGroup(movementType))
                    {
                        <label>
                            Новая группа
                            <select @bind="toGroupId">
                                <option value="">— выберите —</option>
                                @foreach (var group in groups.Where(x => x.Id != student.StudyGroupId))
                                {
                                    <option value="@group.Id">@group.Number (@group.Course курс)</option>
                                }
                            </select>
                        </label>
                    }
                    <div>
                        <button class="primary" @onclick="ApplyAsync" disabled="@busy">Провести</button>
                    </div>
                    <p class="muted">Список событий построен по правилам доменной модели: показаны только допустимые для текущего статуса.</p>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <h2>Контакты</h2>
        @if (student.Contacts.Count > 0)
        {
            <table>
                <tbody>
                    @for (var i = 0; i < student.Contacts.Count; i++)
                    {
                        var index = i;
                        var contact = student.Contacts[i];
                        <tr>
                            <td style="width:140px" class="muted">@Labels.Of(contact.Type)</td>
                            <td>@contact.Value @(contact.IsPrimary ? "· основной" : "")</td>
                            <td class="num">
                                <button class="link-button" @onclick="() => RemoveContactAsync(index)" disabled="@busy">удалить</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted">Контактов нет.</p>
        }
        <div class="toolbar" style="margin-top:12px">
            <select @bind="newContactType">
                @foreach (var type in Enum.GetValues<ContactType>())
                {
                    <option value="@type">@Labels.Of(type)</option>
                }
            </select>
            <input placeholder="Значение" @bind="newContactValue" />
            <button @onclick="AddContactAsync" disabled="@busy">Добавить контакт</button>
        </div>
    </div>

    <div class="card">
        <h2>История движения</h2>
        @if (history.Count == 0)
        {
            <p class="muted">Событий пока нет.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Событие</th>
                        <th>Приказ</th>
                        <th>Группа</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movement in history)
                    {
                        <tr>
                            <td>@movement.EffectiveDate.ToString("dd.MM.yyyy")</td>
                            <td>@Labels.Of(movement.EventType)</td>
                            <td>№ @(movement.Order?.Number)</td>
                            <td>@(movement.FromGroup?.Number ?? "—") → @(movement.ToGroup?.Number ?? "—")</td>
                            <td>@Labels.Of(movement.PreviousStatus) → @Labels.Of(movement.NewStatus)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="toolbar">
        @if (!confirmDelete)
        {
            <button class="danger" @onclick="() => confirmDelete = true">Удалить карточку</button>
        }
        else
        {
            <span>Карточка и вся история будут удалены. Точно?</span>
            <button class="danger" @onclick="DeleteAsync" disabled="@busy">Да, удалить</button>
            <button @onclick="() => confirmDelete = false">Отмена</button>
        }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Student? student;
    private List<MovementEvent> history = new();
    private List<Order> orders = new();
    private List<StudyGroup> groups = new();
    private List<MovementType> allowed = new();

    private MovementType movementType;
    private string orderId = string.Empty;
    private string toGroupId = string.Empty;
    private DateTime effectiveDate = DateTime.Today;

    private ContactType newContactType = ContactType.Phone;
    private string newContactValue = string.Empty;

    private string? loadError;
    private string? error;
    private string? message;
    private bool busy;
    private bool confirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            student = await Api.GetStudentAsync(Id);
            history = await Api.GetHistoryAsync(Id);
            orders = await Api.GetOrdersAsync();
            groups = await Api.GetGroupsAsync();
            // Те же правила переходов, что и на сервере: класс Student из слоя Domain.
            allowed = Enum.GetValues<MovementType>().Where(student.CanApply).ToList();
            if (!allowed.Contains(movementType) && allowed.Count > 0)
            {
                movementType = allowed[0];
            }
            loadError = null;
        }
        catch (Exception ex)
        {
            loadError = Labels.Error(ex);
        }
    }

    private async Task ApplyAsync()
    {
        error = null;
        message = null;
        if (!Guid.TryParse(orderId, out var order))
        {
            error = "Выберите приказ-основание.";
            return;
        }

        Guid? targetGroup = null;
        if (Student.RequiresTargetGroup(movementType))
        {
            if (!Guid.TryParse(toGroupId, out var parsedGroup))
            {
                error = "Выберите новую группу.";
                return;
            }
            targetGroup = parsedGroup;
        }

        busy = true;
        try
        {
            await Api.ApplyMovementAsync(Id, new MovementRequest
            {
                OrderId = order,
                EventType = movementType,
                EffectiveDate = effectiveDate,
                ToGroupId = targetGroup
            });
            message = $"Проведено: {Labels.Of(movementType)}.";
            toGroupId = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = Labels.Error(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AddContactAsync()
    {
        if (student == null || string.IsNullOrWhiteSpace(newContactValue))
        {
            return;
        }
        student.AddContact(new ContactInfo
        {
            Type = newContactType,
            Value = newContactValue.Trim(),
            IsPrimary = student.Contacts.Count == 0
        });
        newContactValue = string.Empty;
        await SaveStudentAsync("Контакт добавлен.");
    }

    private async Task RemoveContactAsync(int index)
    {
        if (student == null)
        {
            return;
        }
        student.RemoveContactAt(index);
        await SaveStudentAsync("Контакт удалён.");
    }

    private async Task SaveStudentAsync(string successMessage)
    {
        error = null;
        message = null;
        busy = true;
        try
        {
            await Api.UpdateStudentAsync(student!);
            message = successMessage;
        }
        catch (Exception ex)
        {
            error = Labels.Error(ex);
        }
        finally
        {
            busy = false;
        }
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        busy = true;
        try
        {
            await Api.DeleteStudentAsync(Id);
            Navigation.NavigateTo("students");
        }
        catch (Exception ex)
        {
            error = Labels.Error(ex);
            busy = false;
        }
    }
}
